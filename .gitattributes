# Was `git archive` - und damit das Release-Zip und Composers dist-Download - weglaesst. Die Extension
# braucht Classes/, Configuration/, Resources/, composer.json und die Dokumentation; alles darunter ist
# fuer die Entwicklung.
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/Build                  export-ignore
/Tests                  export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/playwright.config.ts   export-ignore
/skills                 export-ignore
/.ddev                  export-ignore
