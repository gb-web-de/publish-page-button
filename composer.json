{
    "name": "gb-web-de/publish-page-button",
    "type": "typo3-cms-extension",
    "description": "Publish Page Button - One-Click \"Seite veroeffentlichen\" im Seitenmodul, im Visual Editor und im EditorialFlow-Board: bringt alle Workspace-Aenderungen einer Seite live",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Gordon Brueggemann",
            "email": "gordon.brueggemann@gb-web.de",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/gb-web-de/publish-page-button/issues",
        "source": "https://github.com/gb-web-de/publish-page-button"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-workspaces": "^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "phpstan/phpstan": "^2.1.54",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^11.5.55",
        "saschaegerer/phpstan-typo3": "^3.0.1",
        "typo3/cms-install": "^14.3",
        "typo3/testing-framework": "^9.5"
    },
    "suggest": {
        "gb-web/editorial-flow": "Knopf auch im EditorialFlow-Board"
    },
    "autoload": {
        "psr-4": {
            "GbWebDe\\PublishPageButton\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GbWebDe\\PublishPageButton\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "publish_page_button",
            "web-dir": ".Build/public",
            "app-dir": ".Build"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "optimize-autoloader": true,
        "lock": false,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "cs:check": "${PHP_BINARY} .Build/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-rules.php --diff --dry-run",
        "cs:fix": "${PHP_BINARY} .Build/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-rules.php",
        "phpstan": "${PHP_BINARY} .Build/bin/phpstan analyse -c Build/phpstan/phpstan.neon --no-progress",
        "test:unit": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:acceptance": "bash Build/playwright/run-acceptance.sh",
        "test:coverage": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/UnitTests.xml --coverage-text"
    }
}
